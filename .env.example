# Copy to .env on the server and fill in.

# Your public address, used for canonical links, Open Graph and the sitemap.
# Set it before `npm run build`.
SITE_URL=https://your-domain.ir

# Kavenegar API key and the name of a "verify lookup" template whose
# message contains %token%. Without a key, production refuses to send codes.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=sandogh-login

PORT=3000
DB_PATH=data/sandogh.db
