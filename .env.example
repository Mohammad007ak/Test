# این فایل را کپی کنید به نام .env و مقادیر واقعی را جایگزین کنید:
#   cp .env.example .env
#
# فایل .env هرگز نباید به گیت اضافه شود (از قبل در .gitignore هست).

# یک رشته‌ی تصادفی و طولانی و محرمانه بسازید، مثلاً با:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# روی سرور واقعی همیشه False باشد.
DEBUG=False

# دامنه یا آی‌پی سروری که برنامه رویش اجرا می‌شود، جدا شده با کاما.
# مثال: ALLOWED_HOSTS=example.com,203.0.113.10
ALLOWED_HOSTS=

# اگر بعداً دامنه با HTTPS اضافه کردید، آدرس کامل آن را اینجا هم بگذارید.
# مثال: CSRF_TRUSTED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=

# اطلاعات پایگاه‌داده‌ی PostgreSQL (توسط docker-compose.yml هم استفاده می‌شود).
# اگر از یک سرویس دیتابیس مدیریت‌شده (مثلاً روی یک پلتفرم PaaS) استفاده
# می‌کنید، این مقادیر را با اطلاعات همان سرویس پر کنید.
POSTGRES_DB=security_projects
POSTGRES_USER=security_projects
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# اختیاری: اگر این سه مقدار را پر کنید، هنگام هر بار بالا آمدن برنامه یک
# کاربر ادمین با این مشخصات به‌صورت خودکار ساخته می‌شود (اگر از قبل نباشد).
# برای پلتفرم‌هایی که ترمینال تعاملی برای اجرای createsuperuser نمی‌دهند لازم است.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
