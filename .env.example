# این فایل را کپی کنید به نام .env و مقادیر واقعی را جایگزین کنید:
#   cp .env.example .env
#
# فایل .env هرگز نباید به گیت اضافه شود (از قبل در .gitignore هست).

# یک رشته‌ی تصادفی و طولانی و محرمانه بسازید، مثلاً با:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# روی سرور واقعی همیشه False باشد.
DEBUG=False

# دامنه یا آی‌پی سروری که برنامه رویش اجرا می‌شود، جدا شده با کاما.
# مثال: ALLOWED_HOSTS=example.com,203.0.113.10
ALLOWED_HOSTS=

# اگر بعداً دامنه با HTTPS اضافه کردید، آدرس کامل آن را اینجا هم بگذارید.
# مثال: CSRF_TRUSTED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=

# اطلاعات پایگاه‌داده‌ی PostgreSQL (توسط docker-compose.yml هم استفاده می‌شود)
POSTGRES_DB=security_projects
POSTGRES_USER=security_projects
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
