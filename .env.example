# مسیر دیتابیس (پیش‌فرض: data/finassist.db)
FINASSIST_DATABASE_URL=sqlite:///./data/finassist.db
# کلید امضای نشست؛ اگر خالی باشد یک کلید تصادفی ساخته و در دیتابیس نگه داشته می‌شود
FINASSIST_SECRET_KEY=
# روی سرور: کد لازم برای گذاشتن اولین رمز (خالی = بدون کد، فقط برای اجرای محلی)
FINASSIST_SETUP_CODE=
# روی سرور با HTTPS روشن کن
FINASSIST_SECURE_COOKIES=false
# فاصله دریافت خودکار قیمت وقتی اپ باز است (ثانیه)؛ ۰ = خاموش
FINASSIST_PRICE_REFRESH_SECONDS=30
# وقتی کسی اپ را باز نکرده (دقیقه)
FINASSIST_PRICE_IDLE_MINUTES=60
# توکن اندپوینت پیامک (هدر X-Ingest-Token)؛ خالی = خودکار ساخته و در صفحه پیامک‌ها نشان داده می‌شود
FINASSIST_SMS_TOKEN=
# فایل پیامک‌هایی که Shortcuts در iCloud Drive می‌سازد؛ هر دقیقه خوانده می‌شود
FINASSIST_SMS_FILE=
