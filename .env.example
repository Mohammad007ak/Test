# مسیر دیتابیس (پیش‌فرض: data/finassist.db)
FINASSIST_DATABASE_URL=sqlite:///./data/finassist.db
# کلید امضای نشست؛ اگر خالی باشد یک کلید تصادفی ساخته و در دیتابیس نگه داشته می‌شود
FINASSIST_SECRET_KEY=
# روی سرور با HTTPS روشن کن
FINASSIST_SECURE_COOKIES=false
# فاصله دریافت خودکار قیمت وقتی اپ باز است (ثانیه)؛ ۰ = خاموش
FINASSIST_PRICE_REFRESH_SECONDS=30
# وقتی کسی اپ را باز نکرده (دقیقه)
FINASSIST_PRICE_IDLE_MINUTES=60

# ---------- کد تأیید پیامکی (sms.ir) برای ثبت‌نام و بازیابی رمز ----------
# خالی = کد فقط در لاگ سرور چاپ می‌شود (برای اجرای محلی)
FINASSIST_SMSIR_API_KEY=
# شناسه الگوی «ارسال سریع/وریفای» که در پنل sms.ir تأیید شده
FINASSIST_SMSIR_TEMPLATE_ID=
# نام متغیر کد در متن الگو، مثلاً #CODE#
FINASSIST_SMSIR_PARAM=CODE
# سقف کل پیامک کد در ۲۴ ساعت (سپر هزینه در برابر سوءاستفاده)
FINASSIST_OTP_DAILY_LIMIT=300

# ---------- کاربران ----------
# فقط این شماره‌ها ثبت‌نام می‌کنند (با کاما جدا)؛ خالی = برای همه باز
FINASSIST_SIGNUP_ALLOWLIST=
# صاحب داده‌های نسخه تک‌کاربره؛ با ثبت‌نام این شماره همان داده‌ها را تحویل می‌گیرد
FINASSIST_OWNER_PHONE=
# اختیاری: رمز حساب بالا؛ حساب با هر بار روشن شدن برنامه با همین رمز ساخته/به‌روز می‌شود
# (رمزی که در اپ عوض شود، با روشن شدن بعدی به این مقدار برمی‌گردد؛ برای مدیریت در اپ خالی بگذار)
FINASSIST_OWNER_PASSWORD=

# ---------- دستیار «از وزیر بپرس» (مدل زبانی با API سازگار با OpenAI و function calling) ----------
# خالی = دستیار خاموش
FINASSIST_LLM_URL=
FINASSIST_LLM_KEY=
FINASSIST_LLM_MODEL=
# سقف سؤال روزانه هر کاربر
FINASSIST_LLM_DAILY_LIMIT=30
# open = پیشنهاد مشخص مالی و سرمایه‌گذاری (محیط آزمایشی)؛ strict = فقط تحلیل.
# پیش از عمومی شدن بدون مجوز مشاوره سرمایه‌گذاری، strict بگذار.
FINASSIST_LLM_MODE=open

# آدرس اصلی سایت برای موتور جستجو (sitemap و canonical)
FINASSIST_PUBLIC_URL=https://getvazir.ir
# ایمیل تماس و درخواست حذف حساب در صفحه /privacy (برای بازار هم لازم است)
FINASSIST_CONTACT_EMAIL=
